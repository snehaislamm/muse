{
  "name": "muse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "mkdir -p dist && cp index.html styles.css dist/ && esbuild src/main.tsx --bundle --minify --sourcemap --target=es2020 --outfile=dist/app.js",
    "dev": "npm run build && esbuild src/main.tsx --bundle --sourcemap --outfile=dist/app.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/layout.test.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
